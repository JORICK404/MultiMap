# Скопируй в .env.local для локального запуска (vercel dev).
# На Vercel те же имена задаются в Settings → Environment Variables.

# Подпись сессионной куки. Любая случайная строка от 32 символов:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Вход через Discord: https://discord.com/developers/applications → OAuth2.
# В Redirects добавить https://<домен карты>/api/auth/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Вход через Telegram: бот от @BotFather, команда /setdomain → домен карты.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# Закрытый режим на время тестов: кому можно входить, через запятую.
# Пусто — входят все, у кого соцсеть привязана к аккаунту Multi Punk и есть подписка.
# Вписанные сюда аккаунты пускаются и без ответа Multi Punk. Свой id видно в логе сервера после неудачной попытки.
#   AUTH_ALLOWLIST=discord:123456789012345678,telegram:123456789
AUTH_ALLOWLIST=

# Ключ API Multi Punk (заголовок MULTI-API-KEY): проверка привязки соцсети,
# ника в игре и подписки при входе — api/_lib/multipunk.js.
MP_API_KEY=
# Необязательно: свой список id платных подписок через запятую вместо зашитого в код.
MP_PAID_SUBSCRIPTIONS=

# Уже используется: токен, которым плагин сервера присылает территории.
REGIONS_UPDATE_TOKEN=
