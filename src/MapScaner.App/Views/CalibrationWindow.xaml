<Window x:Class="MapScaner.App.Views.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibrate map crop area"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock TextWrapping="Wrap" MaxWidth="700" Margin="0,0,0,8"
                   Text="The map square was auto-detected below (largest solid non-black area). Check it looks right, nudge it with the fields if needed, or click Auto-detect again — then click Use Selection. This crop area will be reused automatically for every future screenshot at this resolution."/>
        <Border BorderBrush="Gray" BorderThickness="1" Background="Black">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Fill"/>
                <Canvas x:Name="SelectionCanvas" Background="Transparent"
                        MouseLeftButtonDown="SelectionCanvas_MouseDown"
                        MouseMove="SelectionCanvas_MouseMove"
                        MouseLeftButtonUp="SelectionCanvas_MouseUp">
                    <Rectangle x:Name="SelectionRectangle" Stroke="Lime" StrokeThickness="2"
                               StrokeDashArray="4 2" Fill="#3300FF00" IsHitTestVisible="False"/>
                </Canvas>
            </Grid>
        </Border>
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="X:" VerticalAlignment="Center" Grid.Column="0"/>
            <TextBox x:Name="XBox" Grid.Column="1" TextChanged="Field_TextChanged"/>
            <TextBlock Text="Y:" VerticalAlignment="Center" Grid.Column="3"/>
            <TextBox x:Name="YBox" Grid.Column="4" TextChanged="Field_TextChanged"/>
            <TextBlock Text="W:" VerticalAlignment="Center" Grid.Column="6"/>
            <TextBox x:Name="WBox" Grid.Column="7" TextChanged="Field_TextChanged"/>
            <TextBlock Text="H:" VerticalAlignment="Center" Grid.Column="9"/>
            <TextBox x:Name="HBox" Grid.Column="10" TextChanged="Field_TextChanged"/>
        </Grid>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Edge trim (px):" VerticalAlignment="Center" Grid.Column="0" Margin="0,0,8,0"/>
            <TextBox x:Name="TrimBox" Grid.Column="1" Text="2"/>
        </Grid>
        <TextBlock TextWrapping="Wrap" MaxWidth="700" Margin="0,4,0,0" FontSize="11" Foreground="Gray"
                   Text="Shaves this many pixels off each edge of the selection above before saving — the map HUD often has a faint blended border that otherwise shows up as a thin seam where tiles meet."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Auto-detect" Width="100" Margin="0,0,8,0" Click="AutoDetect_Click"/>
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Use Selection" Width="120" Click="UseSelection_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
